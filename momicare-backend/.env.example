# Copy this file to .env (or export these as real environment variables)
# and fill in real values. NEVER commit the actual .env file.

SERVER_PORT=8080

# Database
DB_URL=jdbc:postgresql://localhost:5432/momicare
DB_USERNAME=postgres
DB_PASSWORD=your_real_db_password_here

# JWT - generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=generate_your_own_random_secret_here
JWT_EXPIRATION_MS=86400000

# AI Cross-Check (Gemini). Get a free key at https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# Alerts
ALERT_ESCALATION_WINDOW_MINUTES=60

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
